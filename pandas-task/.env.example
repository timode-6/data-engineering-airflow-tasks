# Optional. Copy to .env to change these; docker compose reads .env by itself

# Linux: your user and group ids (`id -u`, `id -g`), so the files the
# containers write into data/ belong to you. Both are 1000 when unset, the
# usual ids of the first user. macOS and Windows can ignore them
HOST_UID=1000
HOST_GID=1000

# Seconds of log time replayed per real second. 3600 plays the four days of
# the dataset in about two minutes; 0 sends everything as fast as possible
SPEED=3600

# Seconds of log time per journal. At 100 million rows a day, a one-minute
# journal would hold about 70,000 rows. The dataset has about 260 a minute,
# so 3600 (about 16,000 rows per journal) comes closer to that load
JOURNAL_SECONDS=60

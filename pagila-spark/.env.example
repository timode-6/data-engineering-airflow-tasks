# Copy to .env and set a real value. .env is gitignored.
#
#     cp .env.example .env
#
# Read automatically by docker-compose.yml (POSTGRES_PASSWORD).
#
# NOT read by pagila_spark.py — a Python process does not load .env. Export the
# variables into your shell before running the script; see Setup in README.md:
#
#     set -a; source .env; set +a
PAGILA_PASSWORD=change-me

# Defaults below suit docker-compose.yml — uncomment only to point elsewhere.
# PAGILA_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/pagila
# PAGILA_USER=postgres
